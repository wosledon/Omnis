<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omnis.Contracts\Omnis.Contracts.csproj" />
    <ProjectReference Include="..\Omnis.DocumentX\Omnis.DocumentX.csproj" />
    <ProjectReference Include="..\Omnis.EfCore\Omnis.EfCore.csproj" />
    <ProjectReference Include="..\Omnis.Retrieval\Omnis.Retrieval.csproj" />
    <ProjectReference Include="..\Omnis.Workflow\Omnis.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Knowledge\Sql\**\*.sql">
      <Link>sql\Knowledge\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Rag\Sql\**\*.sql">
      <Link>sql\Rag\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Chat\Sql\**\*.sql">
      <Link>sql\Chat\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
